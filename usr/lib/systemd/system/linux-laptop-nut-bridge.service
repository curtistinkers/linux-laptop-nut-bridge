[Unit]
Description=AC/Battery power to NUT synchronizer
After=input.target
Before=nut-driver.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/linux-laptop-nut-bridge/battery-nut-sync.sh
StandardInput=null
StandardOutput=journal
StandardError=journal

User=nut
Group=nut

# Grant explicit, minimal hardware access without root
CapabilityBoundingSet=
AmbientCapabilities=

# System call filtering (Allowing mandatory tools like dd, cat, od)
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Kernel and network lockdown
RestrictAddressFamilies=none
RestrictNamespaces=yes
RestrictRealtime=yes
ProtectClock=yes
ProtectProc=invisible
PrivateNetwork=yes
IPAddressDeny=any
ProtectHostname=yes
MemoryDenyWriteExecute=yes
LockPersonality=yes
RemoveIPC=yes

# Filesystem isolation
ProtectSystem=strict
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectKernelLogs=yes
PrivateTmp=yes
PrivateUsers=yes
RestrictSUIDSGID=yes
UMask=0077
MountFlags=private

# Keep the host /dev but block everything except the input subsystem character devices
PrivateDevices=yes
DevicePolicy=strict
DeviceAllow=/dev/null rw

# Prevent privilege escalation
NoNewPrivileges=yes

# Restrict /run directory access
RuntimeDirectory=linux-laptop-nut-bridge
RuntimeDirectoryPreserve=yes
RuntimeDirectoryMode=700
