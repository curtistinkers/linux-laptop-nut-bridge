#!/bin/env sh
set -e

if [ "$1" = "configure" ]; then
    # 1. Update nut.conf to standalone mode if not already set
    if [ -f /etc/nut/nut.conf ]; then
        sed -i 's/^MODE=.*/MODE=standalone/g' /etc/nut/nut.conf
    fi

    # 2. Append the internal-battery definition to ups.conf if it doesn't exist
    if [ -f /etc/nut/ups.conf ] && ! grep -q "\[internal-battery\]" /etc/nut/ups.conf; then
        cat << 'EOF' >> /etc/nut/ups.conf

[internal-battery]
    driver = dummy-ups
    port = /run/battery-nut-bridge/internal-batter-sync.status
    desc = "Internal Laptop Battery Pseudo-UPS"
EOF
    fi

    # 3. Force systemd to refresh its disk cache BEFORE touching any units
    systemctl daemon-reload

    # 4. Force execute the script once manually to instantly establish the initial
    # status file# This ensures the NUT driver doesn't encounter a missing file
    # error on first launch
    /usr/libexec/latitude-e7440-battery-nut-bridge/battery-nut-sync.sh || true

    # 5. Enable and start the timer
    systemctl enable --now battery-nut-bridge.timer || true

    # 6. Update the driver list and start the server stack asynchronously
    systemctl restart nut-driver-enumerator.service || true
    systemctl enable nut-driver@internal-battery.service || true
    systemctl start nut-driver@internal-battery.service || true
    systemctl restart nut-server.service || true
fi
