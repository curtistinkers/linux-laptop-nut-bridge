#!/bin/env sh
set -e

if [ "$1" = "configure" ]; then
    # 1. Update nut.conf to standalone mode if not already set
    if [ -f /etc/nut/nut.conf ]; then
        sed -i 's/^MODE=.*/MODE=standalone/g' /etc/nut/nut.conf
    fi

    # 2. Append the battery definition to ups.conf if it doesn't exist
    if [ -f /etc/nut/ups.conf ] && ! grep -q "\[battery\]" /etc/nut/ups.conf; then
        cat << 'EOF' >> /etc/nut/ups.conf

[battery]
    driver = dummy-ups
    port = /run/linux-laptop-nut-bridge/internal-battery-sync.status
    desc = "Internal Laptop Battery Pseudo-UPS"
EOF
    fi

    # 3. Force systemd to refresh its disk cache BEFORE touching any units
    systemctl daemon-reload

    # 5. Run the oneshot service to initialize the /run directory and file
    systemctl start linux-laptop-nut-bridge.service || true

    # 5. Enable and start the timer
    systemctl enable linux-laptop-nut-bridge.timer || true
    systemctl start linux-laptop-nut-bridge.timer || true

    # 6. Update the driver list and start the server stack asynchronously
    systemctl daemon-reload
    systemctl restart nut-driver-enumerator.service || true
    systemctl enable nut-driver@battery.service || true
    systemctl start nut-driver@battery.service || true
    systemctl restart nut-server.service || true
fi
