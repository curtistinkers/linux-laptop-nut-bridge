[Unit]
Description=AC/Battery Power to NUT Synchronizer (Oneshot Run)
After=input.target nut-server.service
Before=nut-driver.target

[Service]
Type=oneshot
ExecStart=/usr/libexec/latitude-e7440-battery-nut-bridge/battery-nut-sync.sh

# Lock down the root filesystem, making it entirely read-only
ProtectSystem=strict

# Protect home directories and system logging configurations
ProtectHome=yes
ProtectControlGroups=yes
ProtectKernelModules=yes

# Create a completely isolated, private /tmp directory for this script
PrivateTmp=yes

# Prevent the script from acquiring new privileges or elevation paths
NoNewPrivileges=yes

# Deny access to networking tunnels and kernel clock tuning
RestrictAddressFamilies=none
ProtectClock=yes

# Restrict /run directory access
RuntimeDirectory=battery-nut-bridge
RuntimeDirectoryPreserve=yes

[Install]
WantedBy=multi-user.target
